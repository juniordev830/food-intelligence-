{
  "name": "Food Intelligence",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",

  // Roda uma vez quando o Codespace é criado: instala dependências e o pacote do projeto
  "postCreateCommand": "pip install --upgrade pip && pip install -r requirements.txt && pip install -e .",

  // Porta da API: fica disponível pela aba PORTS do Codespace
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "API Food Intelligence",
      "onAutoForward": "notify"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  }
}
